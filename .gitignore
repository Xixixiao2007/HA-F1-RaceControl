# 构建产物
build/
*.apk
*.idsig
*.ap_
*.dex

# 签名密钥 —— 千万不要提交，详见 README 的「关于签名密钥」
*.keystore
*.jks
*.p12
*.pem
*.key

# 下载的 Android 工具集（由 tools/fetch_sdk.py 生成，约 236 MB）
android-sdk/
_dl_cache/

# 测试中间产物
# 注意：.gitignore **不支持行内注释** —— 模式后面跟的 # 会被当成模式的一部分。
# 所以注释只能单独占一行。
tools/tztest/out/
tools/tztest/javac.args
tools/tztest/e2eout/
tools/tztest/e2e.args
# GlossDump（翻译诊断）的编译产物 —— 它单独编到一个目录，别跟着 out/ 走
tools/tztest/glossout/
tools/tztest/gloss.args
# 上次发布的记录（版本号守卫用），是本机状态不该提交
tools/.release-state.json

# Python
__pycache__/
*.pyc

# 编辑器 / 系统
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
